NODE_ENV="development"
PORT=5000
API_PREFIX="/api/v1"
CORS_ORIGIN="http://127.0.0.1:5175"
MONGODB_URI="mongodb://localhost:27017/ai-smart-classroom"
JWT_ACCESS_SECRET="replace-with-strong-access-secret"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=12
UPLOAD_DIR="uploads"
AI_SERVICE_BASE_URL="http://localhost:8000"
FACE_ENROLLMENT_MAX_FILE_SIZE_MB=10
FACE_ENROLLMENT_MAX_UPLOADS=10
FACE_RECOGNITION_THRESHOLD=0.65

# Required only for: npm run setup:local-auth
# Keep real values in the ignored backend/.env file.
DEV_ADMIN_NAME=""
DEV_ADMIN_EMAIL=""
DEV_ADMIN_PASSWORD=""
DEV_TEACHER_NAME=""
DEV_TEACHER_EMAIL=""
DEV_TEACHER_PASSWORD=""
DEV_TEACHER_EMPLOYEE_ID=""
DEV_TEACHER_DEPARTMENT=""
DEV_TEACHER_DESIGNATION=""
