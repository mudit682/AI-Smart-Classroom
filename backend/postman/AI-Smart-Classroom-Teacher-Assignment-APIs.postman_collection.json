{
  "info": {
    "name": "AI Smart Classroom - Teacher Assignment APIs",
    "description": "Teacher Assignment API collection for the AI Smart Classroom backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Create Teacher Assignment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"subjectId\": \"{{subjectId}}\",\n  \"classroomId\": \"{{classroomId}}\",\n  \"academicYear\": \"2026-27\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/teacher-assignments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "teacher-assignments"
          ]
        }
      },
      "response": []
    },
    {
      "name": "List Teacher Assignments",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/teacher-assignments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "teacher-assignments"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Teacher Assignment By Id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/teacher-assignments/{{teacherAssignmentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "teacher-assignments",
            "{{teacherAssignmentId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Update Teacher Assignment",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"academicYear\": \"2026-27\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/teacher-assignments/{{teacherAssignmentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "teacher-assignments",
            "{{teacherAssignmentId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Delete Teacher Assignment",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/teacher-assignments/{{teacherAssignmentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "teacher-assignments",
            "{{teacherAssignmentId}}"
          ]
        }
      },
      "response": []
    }
  ]
}

