{
  "info": {
    "name": "AI Smart Classroom - Classroom APIs",
    "description": "Classroom Management API collection for the AI Smart Classroom backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Create Classroom",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"CS Sem 1 Section A\",\n  \"department\": \"Computer Science\",\n  \"semester\": 1,\n  \"section\": \"A\",\n  \"academicYear\": \"2026-27\",\n  \"capacity\": 60,\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/classrooms",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "classrooms"
          ]
        }
      },
      "response": []
    },
    {
      "name": "List Classrooms",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/classrooms",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "classrooms"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Classroom By Id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/classrooms/{{classroomId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "classrooms",
            "{{classroomId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Update Classroom",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"capacity\": 72,\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/classrooms/{{classroomId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "classrooms",
            "{{classroomId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Delete Classroom",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/classrooms/{{classroomId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "classrooms",
            "{{classroomId}}"
          ]
        }
      },
      "response": []
    }
  ]
}

