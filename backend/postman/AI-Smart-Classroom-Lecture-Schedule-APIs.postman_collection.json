{
  "info": {
    "name": "AI Smart Classroom - Lecture Schedule APIs",
    "description": "Lecture Scheduling API collection for the AI Smart Classroom backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Create Lecture Schedule",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"teacherAssignmentId\": \"{{teacherAssignmentId}}\",\n  \"classroomId\": \"{{classroomId}}\",\n  \"subjectId\": \"{{subjectId}}\",\n  \"teacherId\": \"{{teacherId}}\",\n  \"academicYear\": \"2026-27\",\n  \"semester\": \"1\",\n  \"dayOfWeek\": \"MONDAY\",\n  \"startTime\": \"09:00\",\n  \"endTime\": \"10:00\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/lecture-schedules",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "lecture-schedules"
          ]
        }
      },
      "response": []
    },
    {
      "name": "List Lecture Schedules",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/lecture-schedules",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "lecture-schedules"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Lecture Schedule By Id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/lecture-schedules/{{lectureScheduleId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "lecture-schedules",
            "{{lectureScheduleId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Update Lecture Schedule",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dayOfWeek\": \"TUESDAY\",\n  \"startTime\": \"10:00\",\n  \"endTime\": \"11:00\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/lecture-schedules/{{lectureScheduleId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "lecture-schedules",
            "{{lectureScheduleId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Delete Lecture Schedule",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/lecture-schedules/{{lectureScheduleId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "lecture-schedules",
            "{{lectureScheduleId}}"
          ]
        }
      },
      "response": []
    }
  ]
}

