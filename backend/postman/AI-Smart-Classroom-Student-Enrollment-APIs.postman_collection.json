{
  "info": {
    "name": "AI Smart Classroom - Student Enrollment APIs",
    "description": "Student Enrollment API collection for the AI Smart Classroom backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Create Student Enrollment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"classroomId\": \"{{classroomId}}\",\n  \"academicYear\": \"2026-27\",\n  \"rollNumber\": \"001\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/student-enrollments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "student-enrollments"
          ]
        }
      },
      "response": []
    },
    {
      "name": "List Student Enrollments",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/student-enrollments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "student-enrollments"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Student Enrollment By Id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/student-enrollments/{{studentEnrollmentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "student-enrollments",
            "{{studentEnrollmentId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Update Student Enrollment",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rollNumber\": \"002\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/student-enrollments/{{studentEnrollmentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "student-enrollments",
            "{{studentEnrollmentId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Delete Student Enrollment",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/student-enrollments/{{studentEnrollmentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "student-enrollments",
            "{{studentEnrollmentId}}"
          ]
        }
      },
      "response": []
    }
  ]
}

